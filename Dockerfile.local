# Fast local update on top of the already verified full neural runtime.
ARG NEURAL_BASE_IMAGE=flycoder-neural-runtime:32b09ae16fcb
FROM ${NEURAL_BASE_IMAGE}
COPY --chown=10001:10001 flycoder /app/flycoder
COPY --chown=10001:10001 scripts /app/scripts
COPY --chown=10001:10001 benchmarks /app/benchmarks
COPY --chown=10001:10001 .github /app/.github
COPY --chown=10001:10001 tests /app/tests
COPY --chown=10001:10001 run-neural.sh /app/run-neural.sh
RUN /app/.venv-neural/bin/python -B -m unittest discover -s /app/tests -q
