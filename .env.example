# Compose reads .env. For local Python, export these variables explicitly.
LLM_ADAPTER=mock
CONNECTOME_ADAPTER=mock
OPENAI_API_KEY=
# Required only in openai mode; choose a Responses API model available to your account.
OPENAI_MODEL=
MAX_STEPS=12
MAX_ATTEMPTS=3
TEST_TIMEOUT=15

# Custom OpenAI-compatible Chat Completions / DeepSeek:
# Set LLM_ADAPTER=deepseek or chat-completions to use these settings.
# DeepSeek preset supplies https://api.deepseek.com when LLM_BASE_URL is empty.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional fallback key for --llm deepseek only.
DEEPSEEK_API_KEY=
LLM_TIMEOUT=60
LLM_MAX_TOKENS=6000
# Retries only for 429/5xx/network errors; 401/402/403 are never retried.
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=0.5
# text omits response_format for providers without JSON mode (JSON content still required).
LLM_JSON_MODE=json_object

# malecns or doomfly requires neural setup and .venv-neural/bin/python.
# Leave empty to use research/neural-map.json.
NEURAL_MAPPING=
